# 复制成 .env 放在项目根目录，pdf2epub 会自动加载。
# 已有同名环境变量时不覆盖（临时 $env:PADDLE_TOKEN=... 依然优先）。
# 值按字面使用，不做 %TEMP% / $HOME 之类的变量展开。

# PaddleOCR（AI Studio 承载的 PaddleOCR-VL）API Token
PADDLE_TOKEN=

# EPUBCheck 一般不需要在这里指定：放进 tools/ 下会自动被发现。
# 要手动指定的话，写**绝对路径**，例如：
# EPUBCHECK_JAR=D:/tools/epubcheck-5.1.0/epubcheck.jar

# 也可用 PDF2EPUB__SECTION__KEY 覆盖任意配置项：
# PDF2EPUB__WORKDIR=.pdf2epub
# PDF2EPUB__PADDLE__MODEL=PaddleOCR-VL-1.6
# PDF2EPUB__CALIBRATE__SCORE_THRESHOLD=0.8
# PDF2EPUB__VALIDATE__FAIL_ON_SEVERITY=ERROR

# --------------------------------------------------------------------------
# 百度翻译开放平台（fanyi-api.baidu.com）
# --------------------------------------------------------------------------
# 管理控制台“我的服务”里的 APPID（一串数字）
BAIDU_TRANS_APPID=

# 同一页面的“密钥”（32 位字符串）：通用/领域文本翻译的 MD5 签名用
BAIDU_TRANS_SECRET=

# 开放平台单独创建的 API Key（大模型翻译鉴权用，与上面的密钥不是同一个东西）
BAIDU_TRANS_API_KEY=
