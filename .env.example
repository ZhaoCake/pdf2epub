# 复制成 .env 放在项目根目录，pdf2epub 会自动加载。
# 已有同名环境变量时不覆盖（临时 $env:MINERU_TOKEN=... 依然优先）。
# 值按字面使用，不做 %TEMP% / $HOME 之类的变量展开。

# MinerU 官方 API Token（在 https://mineru.net/apiManage/token 创建）
MINERU_TOKEN=

# EPUBCheck 一般不需要在这里指定：放进 tools/ 下会自动被发现。
# 要手动指定的话，写**绝对路径**，例如：
# EPUBCHECK_JAR=D:/tools/epubcheck-5.1.0/epubcheck.jar

# 也可用 PDF2EPUB__SECTION__KEY 覆盖任意配置项：
# PDF2EPUB__WORKDIR=.pdf2epub
# PDF2EPUB__MINERU__MODEL_VERSION=vlm
# PDF2EPUB__CALIBRATE__SCORE_THRESHOLD=0.8
# PDF2EPUB__VALIDATE__FAIL_ON_SEVERITY=ERROR
